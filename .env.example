# Copy this file to .env and fill in the values. .env is git-ignored.
# docker compose reads .env automatically.

# Server-side keys, used when the browser sends no key. Each key is only sent
# to its own provider's domain. Leave them empty on a public site, or every
# visitor's requests are billed to these keys.
REQUESTY_API_KEY=
OPENROUTER_API_KEY=
LLMGATEWAY_API_KEY=

# Optional. Uncomment to change the defaults.

# Allow the proxy to forward to any URL typed in the UI (custom or local
# endpoints), not just the providers with a server key. Defaults to on when HOST is a
# loopback address. Don't turn it on for a public server.
# ALLOW_ANY_UPSTREAM=1

# For node server.js only; the Docker image sets its own.
# Listen port (or a pipe/socket path on hosts like iisnode or Passenger).
# PORT=3000
# Listen address. Use 0.0.0.0 to accept connections from other machines.
# HOST=127.0.0.1
