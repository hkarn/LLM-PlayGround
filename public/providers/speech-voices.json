{
  "_notes": [
    "Voice lists per speech model, for models whose list has no voice names. The first entry whose match (a regular expression, with optional flags) fits the model id wins.",
    "groups maps an optgroup label (or \"\" for none) to voices; def is the default voice; required means the API rejects a request without a voice."
  ],
  "voices": [
    {
      "match": "^openai\\/tts-1",
      "required": true,
      "groups": {
        "": [
          "alloy",
          "ash",
          "coral",
          "echo",
          "fable",
          "nova",
          "onyx",
          "sage",
          "shimmer"
        ]
      },
      "note": "tts-1 and tts-1-hd support 9 voices. ballad, verse, marin and cedar are gpt-4o-mini-tts only."
    },
    {
      "match": "^openai\\/",
      "required": true,
      "groups": {
        "": [
          "marin",
          "cedar",
          "alloy",
          "ash",
          "coral",
          "echo",
          "fable",
          "nova",
          "onyx",
          "sage",
          "shimmer",
          "ballad",
          "verse"
        ]
      },
      "note": "OpenAI recommends marin or cedar for best quality."
    },
    {
      "match": "kokoro",
      "flags": "i",
      "def": "af_bella",
      "groups": {
        "American English": [
          "af_heart",
          "af_alloy",
          "af_aoede",
          "af_bella",
          "af_jessica",
          "af_kore",
          "af_nicole",
          "af_nova",
          "af_river",
          "af_sarah",
          "af_sky",
          "am_adam",
          "am_echo",
          "am_eric",
          "am_fenrir",
          "am_liam",
          "am_michael",
          "am_onyx",
          "am_puck",
          "am_santa"
        ],
        "British English": [
          "bf_alice",
          "bf_emma",
          "bf_isabella",
          "bf_lily",
          "bm_daniel",
          "bm_fable",
          "bm_george",
          "bm_lewis"
        ],
        "Japanese": [
          "jf_alpha",
          "jf_gongitsune",
          "jf_nezumi",
          "jf_tebukuro",
          "jm_kumo"
        ],
        "Mandarin Chinese": [
          "zf_xiaobei",
          "zf_xiaoni",
          "zf_xiaoxiao",
          "zf_xiaoyi",
          "zm_yunjian",
          "zm_yunxi",
          "zm_yunxia",
          "zm_yunyang"
        ],
        "Spanish": [
          "ef_dora",
          "em_alex",
          "em_santa"
        ],
        "French": [
          "ff_siwis"
        ],
        "Hindi": [
          "hf_alpha",
          "hf_beta",
          "hm_omega",
          "hm_psi"
        ],
        "Italian": [
          "if_sara",
          "im_nicola"
        ],
        "Brazilian Portuguese": [
          "pf_dora",
          "pm_alex",
          "pm_santa"
        ]
      },
      "note": "The second letter is f for female, m for male. Pick a voice that matches the language of the text."
    },
    {
      "match": "orpheus",
      "flags": "i",
      "def": "tara",
      "groups": {
        "": [
          "tara",
          "leah",
          "jess",
          "leo",
          "dan",
          "mia",
          "zac",
          "zoe"
        ]
      },
      "note": "English voices, listed from most to least natural. Emotive tags like <laugh> or <sigh> work in the text."
    },
    {
      "match": "mimo.*tts",
      "flags": "i",
      "def": "mimo_default",
      "groups": {
        "English": [
          "Mia",
          "Chloe",
          "Milo",
          "Dean"
        ],
        "Chinese": [
          "冰糖",
          "茉莉",
          "苏打",
          "白桦"
        ]
      },
      "note": "mimo_default is Mia outside China."
    },
    {
      "match": "voicedesign",
      "flags": "i",
      "groups": {},
      "placeholder": "describe the voice, e.g. A deep male voice with a calm, authoritative tone",
      "note": "No preset voices. Describe the voice you want in the text box."
    },
    {
      "match": "chatterbox",
      "flags": "i",
      "groups": {},
      "note": "No preset voices. Chatterbox takes the ID of a voice cloned on DeepInfra. Leave it empty for the default voice."
    },
    {
      "match": "csm-1b",
      "flags": "i",
      "groups": {},
      "note": "No documented preset voices. Leave it empty for the default voice."
    }
  ]
}
